# 复制本文件为 .env 并填入真实值（不要提交到代码仓库）
# ============ 飞书多维表格（内容中枢） ============
FEISHU_APP_ID=你的飞书应用AppID
FEISHU_APP_SECRET=你的飞书应用AppSecret
FEISHU_BITABLE_APP_TOKEN=多维表格URL里的app_token
FEISHU_TABLE_ID=数据表table_id

# ============ 发布失败告警（可选，飞书群机器人 Webhook） ============
# 在企业微信群里添加「自定义机器人」拿到 Webhook 地址填这里；留空则只写日志不推送
FEISHU_ALERT_WEBHOOK=

# ============ 字段名映射（仅当你的列名与默认值不同才需改） ============
FIELD_TITLE=选题/标题
FIELD_CONTENT=初稿
FIELD_PLATFORMS=目标平台
FIELD_STATUS=审核状态
FIELD_RECEIPT=发布回执
FIELD_PUBTIME=发布时间

# ============ 百家号（官方内容API） ============
BJH_APP_ID=百家号作者帐号ID
BJH_TOKEN=百家号授权密钥app_token
BJH_IS_ORIGINAL=1          # 1=原创 0=非原创（按账号资质）

# ============ 网易号（媒体开放平台） ============
WY_TOKEN=网易号access_token
WY_CLASSIFY=科技           # 内容分类，见网易号图文分类接口
WY_ORIGINAL=false          # 无原创资质时改 false

# ============ 头条号（开放平台OAuth2，access_token 有效期2小时，需定时刷新） ============
TT_TOKEN=头条号access_token
TT_COVER_TYPE=0            # 0=无图 1=单图 3=三图

# ============ 服务端口（Webhook 模式） ============
PORT=5000
